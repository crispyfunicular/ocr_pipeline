{"breton": "Pe ano hoc'h eus ?", "français": "Quel nom avez-vous ?"}
{"breton": "Yann.", "français": "Jean."}
{"breton": "Hag an dimezell-mañ, pe ano he deus ?", "français": "Et cette demoiselle, quel nom a-t-elle ?"}
{"breton": "Madalen.", "français": "Madeleine."}
{"breton": "Deuit amañ.", "français": "Venez ici."}
{"breton": "Kemerit eur grib.", "français": "Prenez un peigne."}
{"breton": "Kribit ho pleo.", "français": "Peignez-vous les cheveux."}
{"breton": "Gwalc'hit ho tremm.", "français": "Lavez-vous la figure."}
{"breton": "Kemerit ho frilien.", "français": "Prenez votre mouchoir."}
{"breton": "C'houezit ho fri.", "français": "Mouchez-vous."}
{"breton": "Kemerit ar broust-dilhad.", "français": "Prenez la brosse à habits."}
{"breton": "Broustit ho tilhad.", "français": "Brossez vos vêtements."}
{"breton": "Kemerit ar broust-dent.", "français": "Prenez la brosse à dents."}
{"breton": "Broustit ho tent.", "français": "Brossez-vous les dents."}
{"breton": "Dont a ran.", "français": "Je viens."}
{"breton": "Kemer a ran ar grib.", "français": "Je prends le peigne."}
{"breton": "Skriva a ran ar boelladenn.", "français": "J'écris le devoir."}
{"breton": "Ar boelladenn a zo skrivet.", "français": "Le devoir est écrit."}
