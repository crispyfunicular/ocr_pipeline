{"breton": "E peleac'h hoc'h euz hen guelet?", "français": "Où l'avez-vous vu?"}
{"breton": "E Pariz.", "français": "A Paris."}
{"breton": "Penaoz emâ?", "français": "Comment se porte-il?"}
{"breton": "Iac'h manific a oa pa bar-tiiz ac'hano.", "français": "Il se portait fort bien quand j'en partis."}
{"breton": "Ha choum a ra eno?", "français": "Y demeure-t-il?"}
{"breton": "Ia, autrou.", "français": "Oui, monsieur."}
{"breton": "Ha demezet eo?", "français": "Est-il marié?"}
{"breton": "N'en d'eo quet, mes emâ var poent d'en veza.", "français": "Non, mais il est sur le point de l'être."}
{"breton": "Ha petra a ra hen eno?", "français": "Que fait-il là?"}
{"breton": "Alvocad eo, hag istimet braz eo eno.", "français": "Il est avocat, et y est très estimé."}
{"breton": "Trinquet hoc'h euz - hu gantàn?", "français": "Avez-vous trinqué avec lui?"}
{"breton": "Trinquet hon euz meur a vech d'ho iec'het.", "français": "Nous avons trinqué plusieurs fois à votre santé"}
{"breton": "Derc'hel a ra-hen ti eno?", "français": "Y tient-il maison?"}
{"breton": "Ia, autrou.", "français": "Oui, monsieur."}
{"breton": "P'eur e oec'h-hu eno?", "français": "Quand y étiez-vous?"}
{"breton": "Er miz tremenet.", "français": "Le mois passé."}
{"breton": "Ne zistroio-hen quet e Breiz?", "français": "Ne reviendra-t-il pas en Bretagne?"}
{"breton": "Marteze.", "français": "Peut-être."}
{"breton": "Quenavezo, autrou, ie-c'hed mad deoc'h.", "français": "Adieu, monsieur, portez-vous bien."}
{"breton": "Dialog etre diou De-mezel iaouang.", "français": "Dialogue entre deux jeunes Demoiselles."}
{"breton": "Deut mad hoc'h vademe-zel, mont a ren d'ho quelet.", "français": "Vous êtes bien venue, mademoiselle, j'allais vous voir."}
{"breton": "Ho servicherez humbl, va-demezel, penaoz a rit-hu abaoue deac'h?", "français": "Votre très-humble, mademoiselle, comment vous portez-vous depuis hier?"}
{"breton": "Clàn oun eun nebeut.", "français": "Je suis un peu indisposée."}
{"breton": "E peleac'h hoc'h euz poan?", "français": "Où avez-vous mal?"}
{"breton": "Em penn.", "français": "A la tête."}
{"breton": "Perac e sortiit-hu?", "français": "Pourquoi sortez-vous?"}
{"breton": "C'hoant am boa d'ho quelet.", "français": "J'avais envie de vous voir."}
{"breton": "Mont a ren d'ho ti.", "français": "J'allais chez vous."}
{"breton": "Petra zo a nevez e quear?", "français": "Qu'y a-t-il de nouveau en ville?"}
{"breton": "Ha possubl eo?", "français": "Est-il possible?"}
{"breton": "P'eur eo bet demezet?", "français": "Quand a-t-il été marié?"}
{"breton": "Ar mintin-mâ.", "français": "Ce matin."}
{"breton": "Hag hen zo pinvidic?", "français": "Est-il riche?"}
{"breton": "Pevar mil scoet leve en deuz.", "français": "Il a douze mille livres de rente."}
{"breton": "Pe oad en deuz-hen?", "français": "Quel âge a-t-il?"}
{"breton": "Uguent vloaz.", "français": "Vingt ans."}
{"breton": "N'en deuz quen?", "français": "Pas davantage?"}
{"breton": "Nan.", "français": "Non."}
{"breton": "Pe oad en deuz itroun he fried?", "français": "Quel âge a madame son épouse?"}
{"breton": "N'e deuz nemet trinec'h vloaz.", "français": "Elle n'a que dix-huit ans."}
{"breton": "Euz a be tieguez ef hi?", "français": "De quelle famille est-elle?"}
{"breton": "E quear emâ-ben?", "français": "Est-il en ville?"}
{"breton": "Ia.", "français": "Oui."}
{"breton": "Hag hi a zo coant?", "français": "Est-elle jolie?"}
{"breton": "Coant braz.", "français": "Fort jolie."}
{"breton": "Petra e deuz-hi bet en ar-goulou?", "français": "Qu'a-t-elle eu en mariage?"}
{"breton": "Cant mil scoet.", "français": "Cent mille écus."}
{"breton": "Eun argoulou caer eo.", "français": "C'est un beau marige."}
{"breton": "Eur gariolen gaer ho deuz?", "français": "Ils ont une belle voiture?"}
{"breton": "Caer braz.", "français": "Fort belle."}
{"breton": "Ho anaout a rit-hu?", "français": "Les connaissez-vous?"}
{"breton": "Ho anaout a ràn hervez ho guelet.", "français": "Je les connais de vue."}
{"breton": "Me lavaro nevezentiou all deoc'h.", "français": "Je vous dirai d'autres nouvelles."}
{"breton": "Petra?", "français": "Quoi?"}
{"breton": "Mont a ràn e Breiz.", "français": "Je vais en Bretagne."}
{"breton": "P'eur ez eot-hu?", "français": "Quand y allez-vous?"}
{"breton": "Ar zizun guenta.", "français": "La semaine prochaine."}
{"breton": "Ober goap a rit.", "français": "Vous vous moquez."}
{"breton": "Ne ràn quet a c'hoap.", "français": "Je ne me moque pas."}
{"breton": "Piou a ia ganeoc'h?", "français": "Qui va avec vous?"}
{"breton": "Va zad ha va mam.", "français": "Mon père et ma mère."}
{"breton": "Va eston a rit.", "français": "Vous me surprenez."}
{"breton": "Da Roazon ez it-hu?", "français": "Allez-vous à Rennes?"}
