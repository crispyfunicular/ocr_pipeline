{"breton": "N'en deo quet c'hoaz.", "français": "Non, pas encore."}
{"breton": "Ouz piou hoc'h euz-hu comzet?", "français": "A qui avez-vous parlé?"}
{"breton": "Ouz he flac'h a gambr.", "français": "A sa fille de chambre."}
{"breton": "Penaoz e ia-hi?", "français": "Comment se porte-t-elle?"}
{"breton": "Lavaret he deuz din e oa iac'h.", "français": "Elle m'a dit qu'elle se por-te bien."}
{"breton": "Petra he deuz-hi lavaret?", "français": "Qu'a-t-elle dit?"}
{"breton": "Ho trugarecât a ra.", "français": "Elle vous remercie."}
{"breton": "Nevezentiou a ouzoc'h-hu", "français": "Savez-vous des nouvelles?"}
{"breton": "Va zoueza a rit?", "français": "Vous me surprenez."}
{"breton": "Abaoue p'eur e oa-hen clàn?", "français": "Depuis quand était-il ma-lade?"}
{"breton": "N'en d'eo bet clànv nemet tri deiz.", "français": "Il n'a été malade que trois jours."}
{"breton": "Gant peseurt clenved ez eo-hen maro?", "français": "De quelle maladie est-il mort?"}
{"breton": "Gant ar c'hlènvet tom.", "français": "D'une fièvre chaude."}
{"breton": "P'eur e vezo-hen enterret", "français": "Quand sera--t-il enterré?"}
{"breton": "Varc'hoaz da noz.", "français": "Demain au soir."}
{"breton": "Da bet heur?", "français": "A quelle heure?"}
{"breton": "Da seiz heur.", "français": "A sept heures."}
{"breton": "Piou en deuz en lavaret deoc'h?", "français": "Qui est-ce qui vous l'a dit?"}
{"breton": "Ar vrud hanad eo.", "français": "C'est le bruit commun."}
{"breton": "Ha demezet a oa hen?", "français": "Est-il marié?"}
{"breton": "Ia, autrou.", "français": "Oui, monsieur."}
{"breton": "Ha bugale en doa-hen?", "français": "Avait-il des enfants?"}
{"breton": "Beza en devoa, mes maro int.", "français": "Il en avait, mais ils sont morts."}
{"breton": "He c'hreg ha beo eo c'hoaz", "français": "Sa femme vit-elle encore?"}
{"breton": "Clànv braz eo ivez.", "français": "Elle est aussi bien malade."}
{"breton": "En danjer emâ-hi?", "français": "Est-elle en danger?"}
{"breton": "M'her c'hred.", "français": "Je le crois."}
{"breton": "He anaout a rit-hu?", "français": "La connaissez-vous?"}
{"breton": "Anaout a reac'h-hu he fried?", "français": "Connaissiez-vous son ma-ri?"}
{"breton": "He anaout a renn hervez he velet.", "français": "Je le connaissais de vue."}
{"breton": "Ha beza en devoa madou", "français": "Avait-il du bien?"}
{"breton": "En he eaz edo.", "français": "Il était à son aise."}
{"breton": "He c'hreg hag hi zo gla-c'haret braz?", "français": "Sa femme est-elle fort affligée?"}
{"breton": "Disgonsol eo, mervel a ra, great eo anezi.", "français": "Elle est inconsolable, elle se meurt, c'en est fait."}
{"breton": "E peleac'h e choum-hi?", "français": "Où demeure-t-elle?"}
{"breton": "Amâ tost.", "français": "Ici près."}
{"breton": "Dialog. — Cuntinuation euz ar memes sujet.", "français": "Dialogue. — Suite du même sujet."}
{"breton": "Perac na zavit-hu quet?", "français": "Que ne vous levez-vous?"}
{"breton": "Sevel a ràn, autrou.", "français": "Monsieur, je me lève."}
{"breton": "Ret eo deoc'h sevel min-tinnoc'h, e dieguz hoc'h", "français": "Il faut vous lever plus ma-tin, vous êtes trop pa-resseux."}
{"breton": "Perac na respontit-hu quet din, pa ho cal-vàn?", "français": "Pourquoi ne me répondez-vous pas quand je vous appelle?"}
{"breton": "N'em euz quet ho clevet.", "français": "Je ne vous ai pas entendu."}
{"breton": "Goal stard e cousquit eta? Grit tan.", "français": "Vous dormez donc bien fort? Faites du feu."}
{"breton": "Roit din lien fresq.", "français": "Donnez-moi du linge blanc"}
{"breton": "Redit da di va goalc'he-rez.", "français": "Courez chez ma blanchis-seuse."}
{"breton": "Ret eo beza acquedussoc'h", "français": "Il faut être plus soigneux."}
{"breton": "N'hoc'h euz quet acquet ac'hanoun.", "français": "Vous n'avez pas soin de moi."}
{"breton": "Ha bet ez hoc'h-hu e ti va goalc'herez?", "français": "Avez-vous été chez ma blanchisseuse?"}
{"breton": "Ha guen eo va lien?", "français": "Mon linge est-il blanc?"}
{"breton": "E peleac'h emedo va fan-touflou?", "français": "Où sont mes pantoufles?"}
{"breton": "Digaillaret hoc'h euz-hu va boutou?", "français": "Avez-vous décrotté mes souliers?"}
{"breton": "Nettait va habid.", "français": "Nettoyez mon habit."}
{"breton": "Galvit ar c'hemener.", "français": "Appelez le tailleur."}
{"breton": "Digassit dour din.", "français": "Apportez-moi de l'eau."}
{"breton": "Ne zaleit quet.", "français": "Ne tardez pas."}
{"breton": "Perac oc'h euz hu daleet queit amzer.", "français": "Pourquoi avez-vous tardé si longtemps?"}
{"breton": "Grit d'ar c'heguiner pignat var lae.", "français": "Faites monter le cuisinier."}
{"breton": "Lavarit d'ar c'hoïcher sta-ga ar c'hezeg ouz ar ga-rioled.", "français": "Dites au cocher qu'il mette les chevaux à la voiture"}
