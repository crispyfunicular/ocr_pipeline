{"breton": "Gouzout a rit-hu ho quentel dindan henvor ?", "français": "Savez-vous votre leçon par cœur ?"}
{"breton": "N'hoc'h euz quet a vemor.", "français": "Vous n'avez point de mémoire."}
{"breton": "Na laquit quet ho poan.", "français": "Vous ne prenez pas de peine."}
{"breton": "It da bourmen er jardin.", "français": "Allez vous promener dans le jardin."}
{"breton": "N'en em domait quet.", "français": "Ne vous échauffez pas."}
{"breton": "Distroit souden.", "français": "Revenez bientôt."}
{"breton": "Petra a fell deoc'h d'ho coan.", "français": "Que voulez-vous pour votre souper ?"}
{"breton": "Deuit da goania.", "français": "Venez souper."}
{"breton": "Debrit leaz.", "français": "Mangez du lait."}
{"breton": "Na zebrit quet quement a frouez.", "français": "Ne mangez point tant de fruits."}
{"breton": "Clàn a viot.", "français": "Vous serez malade."}
{"breton": "Ar frouez na dall netra.", "français": "Le fruit ne vaut rien."}
{"breton": "Poent eo deoc'h mont da gousquet.", "français": "Il est temps de vous coucher."}
{"breton": "It da gousquet.", "français": "Allez vous coucher."}
{"breton": "En em divisquit.", "français": "Déshabillez-vous."}
{"breton": "Pedit Doue.", "français": "Priez Dieu."}
{"breton": "Savit varc'hoaz mintin mad.", "français": "Levez-vous demain de bon matin."}
{"breton": "Clevet hoc'h euz-hu ar pez en deuz lavaret ?", "français": "Avez-vous entendu ce qu'il a dit ?"}
{"breton": "Clevet a rit-hu ar pez a lavar ?", "français": "Entendez-vous ce qu'il dit ?"}
{"breton": "Va c'hlevet a rit-hu ?", "français": "M'entendez-vous ?"}
{"breton": "Me ho clev.", "français": "Je vous entends."}
{"breton": "N'ho clevàn quet.", "français": "Je ne vous entends pas."}
{"breton": "Entend a rit-hu ar Gallec ?", "français": "Comprenez-vous le Français ?"}
{"breton": "N'en ententàn quet.", "français": "Je ne le comprends pas."}
{"breton": "E entend a ràn erfat.", "français": "Je le comprends bien."}
{"breton": "E entend a ra an autrou ?", "français": "Monsieur le comprend-il ?"}
{"breton": "N'en entend quet", "français": "Il ne le comprend pas."}
{"breton": "Va entendet hoc'h euz-hu ?", "français": "M'avez-vous compris ?"}
{"breton": "N'am euz quet hoc'h ententet.", "français": "Je ne vous ai pas compris."}
{"breton": "Me am euz hoc'h ententet erfat.", "français": "Je vous ai bien compris."}
{"breton": "E ententet hoc'h euz-hu ?", "français": "L'avez-vous compris ?"}
{"breton": "Ho ententet hoc'h euz-hu ?", "français": "Les avez-vous compris ?"}
{"breton": "E ententet hoc'h euz-hi ?", "français": "L'avez-vous comprise ?"}
{"breton": "Ne ouzoun quet petra a lavarit.", "français": "Je ne sais ce que vous dites."}
{"breton": "Petra a lavarit-hu ?", "français": "Que dites-vous ?"}
{"breton": "Petra hoc'h euz-hu lavaret", "français": "Qu'avez-vous dit ?"}
{"breton": "Clevet am euz e lavaret.", "français": "Je l'ai ouï dire."}
{"breton": "Biscoaz n'em euz clevet e lavaret.", "français": "Je ne l'ai jamais ouï dire."}
{"breton": "Lavaret eo het din.", "français": "On me l'a dit."}
{"breton": "Hel lavaret a rer.", "français": "On le dit."}
{"breton": "An holl hel lavar.", "français": "Tout le monde le dit."}
{"breton": "An autrou en deuz e lavaret din.", "français": "Monsieur me l'a dit."}
{"breton": "Lavaret e deuz-hen deoc'h ?", "français": "Vous l'a-t-il dit ?"}
{"breton": "An itroun ne deuz quet e lavarent din.", "français": "Madame ne me l'a pas dit."}
{"breton": "Lavaret e deuz-hi deoc'h ?", "français": "Vous l'a-t-elle dit ?"}
{"breton": "P'eur hoc'h euz-hu clevet e lavaret ?", "français": "Quand l'avez-vous ouï dire ?"}
{"breton": "Hirio em euz clevet e lavaret.", "français": "Je l'ai ouï dire aujourd'hui."}
{"breton": "Piou en deuz e lavaret d'eoc'h ?", "français": "Qui vous l'a dit ?"}
{"breton": "N'her c'hredàn quet.", "français": "Je ne le crois pas."}
{"breton": "Petra lavar-hen ?", "français": "Que dit-il ?"}
{"breton": "Petra lavar-hi ?", "français": "Que dit-elle ?"}
{"breton": "Petra e deuz hen lavaret d'eoc'h ?", "français": "Que vous a-t-il dit ?"}
{"breton": "N'en deuz lavaret netra din", "français": "Il ne m'a rien dit."}
{"breton": "Petra en deuz hi lavaret d'eoch ?", "français": "Que vous a-t-elle dit ?"}
{"breton": "Hi n'e deuz lavaret netra din.", "français": "Elle ne m'a rien dit."}
{"breton": "N'en deuz lavaret quelou ebet din.", "français": "Il ne m'a pas dit de nouvelles."}
{"breton": "An autrou en deuz lavaret quelou din.", "français": "Monsieur m'a dit des nouvelles."}
{"breton": "Na lavarit quet dezàn an dra-ze.", "français": "Ne lui dites pas cela."}
{"breton": "Me lavaro dezàn.", "français": "Je lui dirai."}
{"breton": "Ne lavarin quet dezàn.", "français": "Je ne lui dirai pas."}
{"breton": "Ne lavarin quet dezo.", "français": "Je ne leur dirai pas."}
{"breton": "Ne lavarit quet dezo.", "français": "Ne leur dites pas."}
{"breton": "Lavaret hoc'h euz-hu an dra-ze ?", "français": "Avez-vous dit cela ?"}
