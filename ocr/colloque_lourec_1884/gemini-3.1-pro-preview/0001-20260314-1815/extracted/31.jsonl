{"breton": "Ne fell quet din demezi.", "français": "Je ne veux pas me marier."}
{"breton": "Ien braz eo.", "français": "Il fait bien froid."}
{"breton": "Ien braz am euz.", "français": "J'ai grand froid."}
{"breton": "N'hoc'h euz-hu quet ien ?", "français": "N'avez-vous pas froid."}
{"breton": "Ah ! peguen ien eo.", "français": "Ah! qu'il fait froid."}
{"breton": "Tomit.", "français": "Chauffez-vous."}
{"breton": "Tostait ouz an tan.", "français": "Approchez-vous du feu."}
{"breton": "Tommomp.", "français": "Chauffons-nous."}
{"breton": "Grit tan mad.", "français": "Faites bon feu."}
{"breton": "Gri tan.", "français": "Faites du feu."}
{"breton": "C'huezit an tan.", "français": "Soufflez le feu."}
{"breton": "Ellumit an tan.", "français": "Allumez le feu."}
{"breton": "Maro eo an tan.", "français": "Le feu est éteint."}
{"breton": "Laquit eur fagoden en tan.", "français": "Mettez un fagot au feu."}
{"breton": "Devomp eur fagoden.", "français": "Brûlons un fagot."}
{"breton": "Laquit glaou en tan.", "français": "Mettez du charbon au feu."}
{"breton": "Mouguit an tan.", "français": "Eteignez le feu."}
{"breton": "Ellumit ar goulou.", "français": "Allumez la chandelle."}
{"breton": "Mouguit ar goulou.", "français": "Eteignez la chandelle."}
{"breton": "Chetu eun tan mad.", "français": "Voilà un bon feu."}
{"breton": "Ar glaou-ze a zev manific.", "français": "Ce charbon-là brûle bien."}
{"breton": "Mouchit ar goulou.", "français": "Mouchez la chandelle."}
{"breton": "Chetu aze queuneud mad.", "français": "Voilà de bon bois."}
{"breton": "Glao a ra.", "français": "Il pleut."}
{"breton": "Avel a ra.", "français": "Il fait du vent."}
{"breton": "Avel braz a ra.", "français": "Il fait grand vent."}
{"breton": "Scorni a ra.", "français": "Il gèle."}
{"breton": "Discorni a ra.", "français": "Il dégèle."}
{"breton": "Erc'h a ra.", "français": "Il neige."}
{"breton": "Grisil a ra.", "français": "Il grêle."}
{"breton": "Ha scorni a ra.", "français": "Gèle-t-il ?"}
{"breton": "Hag erc'h a ra ?", "français": "Neige-t-il ?"}
{"breton": "Deuit da doma.", "français": "Venez vous chauffer."}
{"breton": "Ha quen ien eo e Pariz evel e Breiz ?", "français": "Fait-il aussi froid à Paris qu'en Bretagne ?"}
{"breton": "Ienoc'h eo e Pariz eguet amân.", "français": "Il fait plus froid à Paris qu'ici."}
{"breton": "Hemàn zo eun devez goal trist.", "français": "Voici un jour fort mélancolique."}
{"breton": "Goal berr eo an deiziou.", "français": "Les jours sont fort courts."}
{"breton": "Ne quet deiz da seiz heur.", "français": "Il n'est pas jour à sept heures."}
{"breton": "Ne quet mui deiz da bemp heur.", "français": "Il ne fait plus jour à cinq heures."}
{"breton": "Hir braz eo an noziou.", "français": "Les nuits sont fort longues."}
{"breton": "Ne ouzor quet da bettra tremen an amzer.", "français": "On ne sait à quoi passer le temps."}
{"breton": "Ar gouanv na blij quet din.", "français": "L'hiver ne me plaît pas."}
{"breton": "Noz eo dija.", "français": "Il est déjà nuit."}
{"breton": "Ne d'eo mui sclear da bemp heur.", "français": "On ne voit plus à cinq heures."}
{"breton": "Eun amzer trist eo.", "français": "C'est une saison triste."}
{"breton": "Brumen a ra.", "français": "Il fait du brouillard."}
{"breton": "Ne veler nag an env nag an douar.", "français": "On ne voit ni ciel ni terre."}
{"breton": "Ténval braz eo.", "français": "Il fait bien sombre."}
{"breton": "Coumanç a ra an deiziou da hirât.", "français": "Les jours commencent à croître."}
{"breton": "An deiziou a zo eun nebeut astennet.", "français": "Les jours sont un peu allongés."}
{"breton": "Ne d'eo quet quen ien hirio evel deac'h.", "français": "Il ne fait pas si froid aujourd'hui qu'hier."}
{"breton": "Ienoc'h eo hirio eguet deac'h.", "français": "Il fait plus froid aujourd'hui qu'hier."}
{"breton": "Ien braz eo c'hoaz.", "français": "Il fait encore bien froid."}
{"breton": "Ien braz e oa deac'h.", "français": "Il faisait hier fort froid."}
{"breton": "Ienoc'h e oa valerne.", "français": "Il faisait plus froid l'année passée."}
{"breton": "Chetu amàn eur gouanv goal ien.", "français": "Voici un hiver bien froid."}
{"breton": "N'hon euz quet a gouanv.", "français": "Nous n'avons point d'hiver."}
{"breton": "Tremenet eo ar gouanv.", "français": "L'hiver est passé."}
{"breton": "Bremâ ez euz daou vloaz hor boe eur gouanv calet.", "français": "Nous eûmes un rude hiver il y a deux ans."}
{"breton": "Ha sonch hoc'h euz-hu euz ar gouanv braz ?", "français": "Vous souvient-il du grand hiver ?"}
{"breton": "Biscoaz n'am euz guelet eur gouanv quer ien.", "français": "Je n'ai jamais vu un hiver si froid."}
{"breton": "Amzer gaer a ra.", "français": "Il fait beau temps."}
{"breton": "Oh ! an deiz caer !", "français": "Ah ! le beau jour !"}
{"breton": "Deomp da bourmen.", "français": "Allons nous promener."}
{"breton": "Caer braz eo var ar meaz.", "français": "Il fait beau à la campagne."}
{"breton": "Chetu aze eur boquet caer.", "français": "Voilà un beau bouquet."}
{"breton": "C'houez mad zo gant ar boquet-mâ.", "français": "Ce bouquet sent bon."}
