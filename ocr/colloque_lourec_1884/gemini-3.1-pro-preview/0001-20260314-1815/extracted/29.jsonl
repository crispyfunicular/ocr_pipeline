{"breton": "Nan, n'am euz quet hen lavaret.", "français": "Non, je ne l'ai pas dit."}
{"breton": "An autrou en deuz en lavaret din.", "français": "Monsieur me l'a dit."}
{"breton": "Anaout a rit-hu anezàn ?", "français": "Le connaissez-vous ?"}
{"breton": "Anaout a rit-hu anezi ?", "français": "La connaissez-vous ?"}
{"breton": "Ho anaout a rit-hu ?", "français": "Les connaissez-vous ?"}
{"breton": "Ne anavezàn quet anezo.", "français": "Je ne les connais pas."}
{"breton": "En em anaout a reomp.", "français": "Nous nous connaissons."}
{"breton": "N'en em anavezomp quet.", "français": "Nous ne nous connaissons pas."}
{"breton": "Me gred ec'h anavezàn anezàn.", "français": "Je crois que je le connais."}
{"breton": "Me gred am euz en guelet.", "français": "Je crois que je l'ai vu."}
{"breton": "Anavezet am euz anezàn.", "français": "Je l'ai connu."}
{"breton": "Anavezet am euz anezi.", "français": "Je l'ai connue."}
{"breton": "En em anavezet oump.", "français": "Nous nous sommes connus."}
{"breton": "Va anaout a rea erfat.", "français": "Il me connaissait bien."}
{"breton": "Biscoaz n'am euz anavezet.", "français": "Je ne l'ai jamais connu."}
{"breton": "Va anaout a rit-hu ?", "français": "Me connaissez-vous ?"}
{"breton": "Ne anavezit-hu quet ac'hanoun ?", "français": "Ne me connaissez-vous pas ?"}
{"breton": "Ancounac'heat am euz hoc'h hano.", "français": "J'ai oublié votre nom."}
{"breton": "Va ancounac'heat hoc'h euz-hu ?", "français": "M'avez-vous oublié ?"}
{"breton": "Hoc'h anaout a ra-hi ?", "français": "Vous connait-elle ?"}
{"breton": "Hoc'h anaout a ra an autrou ?", "français": "Monsieur vous connait-il ?"}
{"breton": "An autrou n'em anavez quet.", "français": "Monsieur ne me connait pas."}
{"breton": "An autrou em anavez erfat.", "français": "Monsieur me connait bien."}
{"breton": "N'em anavez quet.", "français": "Il ne me connait pas."}
{"breton": "Dianavezet oun gantàn.", "français": "Il ne me connait plus."}
{"breton": "Va ancounac'heat en deveuz.", "français": "Il m'a oublié."}
{"breton": "Dianavezet oun ganti.", "français": "Elle ne me connait plus."}
{"breton": "En em velet a rit-hu ?", "français": "Vous voyez-vous ?"}
{"breton": "Alies her guelàn.", "français": "Je le vois souvent."}
{"breton": "Alies e velàn anezi.", "français": "Je la vois souvent."}
{"breton": "Alies en em velomp.", "français": "Nous nous voyons souvent"}
{"breton": "N'en em velomp mui.", "français": "Nous ne nous voyons plus."}
{"breton": "Alies ho guelàn.", "français": "Je les vois souvent."}
{"breton": "Pell braz zo n'am euz quet guelet anezàn.", "français": "Il y a longtemps que je ne l'ai vu."}
{"breton": "Pell amzer zo n'am euz quet guelet anezi.", "français": "Il y a longtemps que je ne les ai vus."}
{"breton": "Pell amzer zo n'am euz quet guelet anezo.", "français": "Il y a longtemps que je ne l'ai vue."}
{"breton": "N'ho queler mui.", "français": "On ne vous voit plus."}
{"breton": "Miracl eo ho quelet.", "français": "C'est miracle de vous voir."}
{"breton": "En em velet oump bet guech all.", "français": "Nous nous sommes vus autrefois."}
{"breton": "An autrou en deuz guelet ac'hanoun.", "français": "Monsieur m'a vu."}
{"breton": "Morse n'en deuz va guelet.", "français": "Il ne m'a jamais vu."}
{"breton": "N'am euz hen guelet nemet eur vech em buez.", "français": "Je ne l'ai vu qu'une fois en ma vie."}
{"breton": "Me am euz hen guelet dre chans.", "français": "Je l'ai vu par hasard."}
{"breton": "N'her guelan mui.", "français": "Je ne le vois plus."}
{"breton": "It da velet.", "français": "Allez-y voir."}
{"breton": "P'eur e velot-hu an autrou ?", "français": "Quand verrez vous monsieur ?"}
{"breton": "Me am euz an enor da veza anavezet gantàn.", "français": "J'ai l'honneur d'être connu de lui."}
{"breton": "M'her guelo goude creizdeiz.", "français": "Je le verrai après midi."}
{"breton": "Me ho ped d'ober va gourc'hemennou dezàn.", "français": "Je vous prie de lui faire mes compliments."}
{"breton": "Guelit ped heur eo.", "français": "Voyez quelle heure il est."}
{"breton": "Gouzout a rit hu ped heur eo ?", "français": "Savez-vous quelle heure il est ?"}
{"breton": "Lavarit din ped heur eo.", "français": "Dites-moi quelle heure il est."}
{"breton": "Ne ouzoc'h-hu quet ped heur eo ?", "français": "Ne savez-vous pas quelle heure il est ?"}
{"breton": "Ne ouzo un quet ped heur eo.", "français": "Je ne sais pas quelle heure il est."}
{"breton": "Emâ eun heur o paouez sonn.", "français": "Une heure vient de sonner."}
{"breton": "Eun heur ha quart eo.", "français": "Il est une heure et quart."}
{"breton": "Eun heur hanter eo.", "français": "Il est une heure et demie."}
{"breton": "Eun heur ha tri c'hart eo.", "français": "Il est une heure et trois quarts."}
{"breton": "Div heur eo souden.", "français": "Il est bientôt deux heures."}
