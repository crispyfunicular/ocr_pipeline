{"breton": "Penaoz e ia an introun ?", "français": "Comment se porte madame ?"}
{"breton": "Iac'h manific.", "français": "Elle se porte bien."}
{"breton": "Me gred emâ iac'h.", "français": "Je crois qu'elle se porte bien."}
{"breton": "Deac'h vintin e oa iac'h manific.", "français": "Elle se portait bien hier au matin."}
{"breton": "Guelet hoc'h euz-hu an autrou ?", "français": "Avez-vous vu monsieur ?"}
{"breton": "M'her guelaz deac'h.", "français": "Je le vis hier."}
{"breton": "M'her guelaz en deiz all.", "français": "Je le vis l'autre jour."}
{"breton": "M'her guelaz ar zizun dremenet.", "français": "Je le vis la semaine passée."}
{"breton": "Bremâ souden em euz hen guelet.", "français": "Je viens de le voir."}
{"breton": "Hen guelet am euz hirio.", "français": "Je l'ai vu aujourd'hui."}
{"breton": "Ha penaoz a ia ?", "français": "Comment se porte-t-il ?"}
{"breton": "Manific.", "français": "Fort bien."}
{"breton": "Bet ez hoc'h-hu e quear ?", "français": "Avez-vous été en ville ?"}
{"breton": "Deac'h e oen.", "français": "J'y fus hier."}
{"breton": "Anaout a rit-hu an autrou ?", "français": "Connaissez-vous monsieur ?"}
{"breton": "Men hen anavez mad.", "français": "Je le connais bien."}
{"breton": "Ne anavezan quet anezàn.", "français": "Je ne le connais pas."}
{"breton": "M'hen anavez evit he velet.", "français": "Je le connais de vue."}
{"breton": "M'hen anavez dre vrud.", "français": "Je le connais de réputation."}
{"breton": "An enor am euz d'he anaout.", "français": "J'ai l'honneur de le connaître."}
{"breton": "N'am euz quet an enor d'hoc'h anaout.", "français": "Je n'ai pas l'honneur de vous connaître."}
{"breton": "Anaout a rit-hu an itroun ?", "français": "Connaissez-vous madame ?"}
{"breton": "Anaout a ràn mad anezi.", "français": "Je la connais bien."}
{"breton": "Ne anavezàn quet anezi.", "français": "Je ne la connais pas."}
{"breton": "E anaout a ràn hervez he guelet.", "français": "Je la connais de vue."}
{"breton": "An enor am euz d'he anaout anezi.", "français": "J'ai l'honneur de la connaître."}
{"breton": "N'am euz quet an enor da anaout anezi.", "français": "Je n'ai pas l'honneur de la connaître."}
{"breton": "P'eur hoc'h euz-hu guelet vademezel ?", "français": "Quand avez-vous vu mademoiselle ?"}
{"breton": "P'eur hoc'h euz-hi guelet ?", "français": "Quand l'avez-vous vue ?"}
{"breton": "Deac'h her gueliz.", "français": "Je la vis hier."}
{"breton": "A bele ac'h e tenit-hu ?", "français": "D'où venez-vous ?"}
{"breton": "Euz a Roazon e tenàn.", "français": "Je viens de Rennes."}
{"breton": "Euz al Lez.", "français": "De la Cour."}
{"breton": "Euz a di an autrou...", "français": "De chez monsieur..."}
{"breton": "Pe seurt quelou zo ?", "français": "Quelle nouvelle y a-t-il ?"}
{"breton": "Ne ouzoun nicun.", "français": "Je n'en sais aucune."}
{"breton": "N'am euz quet lennet ar gazetten.", "français": "Je n'ai pas lu la gazette."}
{"breton": "E peleac'h e zit-hu ?", "français": "Où allez-vous ?"}
{"breton": "Da Vontroulez.", "français": "A Morlaix."}
{"breton": "Da Vrest.", "français": "A Brest."}
{"breton": "D'an iliz.", "français": "A l'église."}
{"breton": "Da di an itroun.", "français": "Chez madame."}
{"breton": "D'hon ti-ni.", "français": "Chez nous."}
{"breton": "Amâ tost.", "français": "Ici près."}
{"breton": "Grit va gourc'hemennou d'an itroun.", "français": "Faites mes compliments à madame."}
{"breton": "Ne vanquin quet.", "français": "Je n'y manquerai pas."}
{"breton": "Quenavezo.", "français": "Adieu."}
{"breton": "Dialog etre diou Demezel.", "français": "Dialogue entre deux Demoiselles."}
{"breton": "Vademezel, ho servicherez humbl.", "français": "Mademoiselle, votre très humble servante."}
{"breton": "Me zo hoc'h hini.", "français": "Je suis la vôtre."}
{"breton": "Iac'h ez hoc'h-hu.", "français": "Vous portez-vous bien ?"}
{"breton": "Ia, a drugare Doue, mes glac'haret braz oun.", "français": "Oui, Dieu merci, mais je suis fort affligée."}
{"breton": "Perac ?", "français": "Pourquoi ?"}
{"breton": "An Itroun ne d'eo quet iac'h.", "français": "Madame ne se porte pas bien."}
{"breton": "Petra c'hoarvez ganti ?", "français": "Qu'a-t-elle ?"}
{"breton": "Poan e deuz en he fenn.", "français": "Elle a mal à la tête."}
{"breton": "N'hellan-me quet he guelet", "français": "Ne puis-je pas la voir ?"}
{"breton": "Ne ouzon quet.", "français": "Je ne sais pas."}
{"breton": "En he guele emâ-hi ?", "français": "Est-elle couchée ?"}
{"breton": "Hag hi a zo cousquet ?", "français": "Dort-elle ?"}
{"breton": "Me a ia da velet anezi.", "français": "Je m'en vais la voir."}
{"breton": "Ho pedi a ràn d'he iscuzi.", "français": "Elle vous prie de l'excuser"}
{"breton": "Ne hell quet parlant oc'h den.", "français": "Elle ne saurait parler à personne."}
{"breton": "Emâ ho clasq reposi.", "français": "Elle tâche de reposer."}
