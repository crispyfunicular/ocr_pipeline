{"breton": "Deomp da ober eun dro jardin.", "français": "Allons faire un tour de jardin."}
{"breton": "Deom en disheol.", "français": "Allons à l'ombre."}
{"breton": "Penaoz e c'halver ar fleuren-mâ ?", "français": "Comment s'appelle cette fleur ?"}
{"breton": "Chetu eur fleuren gaer.", "français": "Voilà une belle fleur."}
{"breton": "Grit eur boquet din.", "français": "Faites-moi un bouquet."}
{"breton": "Chetu roz caer.", "français": "Voilà de belles roses."}
{"breton": "Roit unan din.", "français": "Donnez-m'en une."}
{"breton": "Quemerit unan.", "français": "Prenez-en une."}
{"breton": "Chetu eun ale gaer.", "français": "Voilà une belle allée."}
{"breton": "Ar guez zo bleunviet caer.", "français": "Les arbres sont bien fleuris."}
{"breton": "Roit din an dulipezen ze.", "français": "Donnez-moi cette tulipe."}
{"breton": "Coumanç a ra da veza tom.", "français": "Il commence à faire chaud."}
{"breton": "Querez am euz debret dija.", "français": "J'ai déjà mangé des cerises."}
{"breton": "Deomp da ober eur bourmenaden.", "français": "Allons faire une promenade."}
{"breton": "Pourmenomp.", "français": "Promenons-nous."}
{"breton": "An amzer zo douç braz.", "français": "Le temps est fort doux."}
{"breton": "Ha fellout a ra deoc'h ez afemp da bourmen goude coan ?", "français": "Voulez-vous que nous nous promenions après souper ?"}
{"breton": "An amzeriou zo chenchet.", "français": "Les saisons sont changées."}
{"breton": "N'euz netra prim.", "français": "Rien n'est avancé."}
{"breton": "Re brim eo pep tra.", "français": "Tout est trop avancé."}
{"breton": "Oh! peguen tom eo.", "français": "Ah! qu'il fait chaud."}
{"breton": "Tom braz eo hirio.", "français": "Il fait chaud aujourd'hui."}
{"breton": "Eun domder divoder a ra.", "français": "Il fait une chaleur excessive."}
{"breton": "Na hellàn quet anduri an domder.", "français": "Je ne saurais endurer la chaleur."}
{"breton": "Ne garàn quet an domder.", "français": "Je n'aime pas la chaleur."}
{"breton": "C'huezi a ràn.", "français": "Je sue."}
{"breton": "Gleb-dour oun.", "français": "Je suis tout en eau."}
{"breton": "An domder a vir ouzoun da gousquet.", "français": "La chaleur m'empêche de dormir."}
{"breton": "Ne quet quen tom hirio evel ma oa deac'h.", "français": "Il ne fait pas si chaud aujourd'hui qu'il faisait hier."}
{"breton": "Mervel a ràn gant an domder.", "français": "Je meurs de chaud."}
{"breton": "Eun hanv goal tom hon euz.", "français": "Nous avons un été bien chaud."}
{"breton": "Fresqueat eo an ear.", "français": "L'air est rafraîchi."}
{"breton": "N'em euz biscoaz santet eun hevelep tomder.", "français": "Je n'ai jamais senti une telle chaleur."}
{"breton": "Ha quen tom eo e Spagn evel amâ ?", "français": "Fait-il aussi chaud en Espagne qu'ici ?"}
{"breton": "Tommoc'h eo eno.", "français": "Il y fait plus chaud."}
{"breton": "Tom braz eo eno.", "français": "Il y fait bien chaud."}
{"breton": "Deomp d'en em voalc'hi.", "français": "Allons nous baigner."}
{"breton": "An domder a zo tremenet.", "français": "La chaleur est passée."}
{"breton": "Ne hellan ober netra epad an domder.", "français": "Je ne saurais rien faire durant la chaleur."}
{"breton": "Ezom hon euz a c'hlao.", "français": "Nous avons besoin de pluie."}
{"breton": "Eur founder vraz a frouez a zo bet er bloaz-mâ.", "français": "Il y a eu grande abondance de fruits cette année."}
{"breton": "Chetu aze eur sucrin caer.", "français": "Voilà un beau melon."}
{"breton": "Caret a rit-hu ar sucrinet ?", "français": "Aimez-vous les melons ?"}
{"breton": "Mont a reomp var ar meaz.", "français": "Nous allons à la campagne."}
{"breton": "Re dom eo.", "français": "Il fait trop chaud."}
{"breton": "Ne zortiomp quet.", "français": "Ne sortons pas."}
{"breton": "Curun a ra.", "français": "Il tonne."}
{"breton": "Luc'het a ra.", "français": "Il fait des éclairs."}
{"breton": "Eun arnen braz eo.", "français": "C'est un grand orage."}
{"breton": "An hid a zo breinet.", "français": "Les blés sont gâtés."}
{"breton": "Emaomp er stereden ar c'hi.", "français": "Nous sommes à la canicule."}
{"breton": "Stereden ar c'hi a zo tremenet.", "français": "La canicule est passée."}
{"breton": "An deiziou a zo bereat calz.", "français": "Les jours sont fort raccourcis."}
{"breton": "Ien eo diouc'h ar mintin.", "français": "Il fait froid le matin."}
{"breton": "An eostou a zo caer er bloaz-mâ.", "français": "Les moissons sont belles cette année."}
{"breton": "Arru eo ar gouanv.", "français": "L'hiver vient."}
{"breton": "Tostât a ra ar gouanv.", "français": "L'hiver s'approche."}
{"breton": "An nosveziou a zo hir.", "français": "Les soirées sont longues."}
{"breton": "Mad eo beza etal an tan.", "français": "Il fait beau auprès du feu."}
{"breton": "Calz guin zo er bloaz-mâ.", "français": "Il y a des vins cette année."}
{"breton": "Ar guin a zo marc'hat mad.", "français": "Le vin est à bon marché."}
{"breton": "Ar guiniennou a oa caer.", "français": "Les vignes étaient belles."}
{"breton": "Dastumet ez euz calz a frouez.", "français": "On a bien ramassé du fruit."}
