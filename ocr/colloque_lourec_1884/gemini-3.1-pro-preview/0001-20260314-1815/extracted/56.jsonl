{"breton": "Ret eo beza primoc'h.", "français": "Il faut être plus diligent."}
{"breton": "Dioualit da eva re.", "français": "Prenez garde de trop boire"}
{"breton": "It da guerc'hat din ar barver.", "français": "Allez me chercher le barbier."}
{"breton": "Goulennet ez oun-me bet?", "français": "M'a-t-on demandé?"}
{"breton": "Mar goulenner ac'hanoun e vezin e ti an autrou...", "français": "Si l'on me demande, je serai chez monsieur..."}
{"breton": "Ho pezit acqued euz va lien.", "français": "Ayez soin de mon linge."}
{"breton": "Na gollit quet va lien.", "français": "Ne perdez pas mon linge."}
{"breton": "Cassit al lizer-mâ d'ar post.", "français": "Portez cette lettre à la poste."}
{"breton": "Ha denet eo ar post?", "français": "Le courrier est-il venu?"}
{"breton": "Ha partiet eo ar post.", "français": "Le courrier est-il parti?"}
{"breton": "Ha lizérou zo evidoun-me?", "français": "Y a-t-il des lettres pour moi?"}
{"breton": "Peguement hoc'h euz-hu paet?", "français": "Combien avez-vous payé?"}
{"breton": "Cassit an dra-ze d'an eac'h.", "français": "Portez cela là-haut."}
{"breton": "Galvit ac'hanoun da ziv heur.", "français": "Appelez-moi à deux heures."}
{"breton": "Diunit ac'hanoun varc'hoaz da c'huec'h heur.", "français": "Eveillez-moi demain à six heures."}
{"breton": "It da gousquat.", "français": "Allez vous coucher."}
{"breton": "Savit varc'hoaz mintin mad.", "français": "Levez-vous demain de bon matin."}
{"breton": "N'ancounac'hait quet.", "français": "N'oubliez pas."}
{"breton": "Tennit va boutou.", "français": "Déchaussez-moi."}
{"breton": "Divisquit ac'hanoun.", "français": "Déshabillez-moi."}
{"breton": "Goustadic.", "français": "Tout doucement."}
{"breton": "Aoualc'h eo.", "français": "C'est assez."}
{"breton": "Dialog.", "français": "Dialogue."}
{"breton": "Mezer mad hoc'h euz-hu?", "français": "Avez-vous de bon drap?"}
{"breton": "Peseurt mezer a fell deoc'h", "français": "De quel drap voulez-vous?"}
{"breton": "Mezer du.", "français": "Du drap noir."}
{"breton": "Chetu aze.", "français": "En voilà."}
{"breton": "Peguement ar voalen?", "français": "Combien l'aune?"}
{"breton": "Uguent liour ar voalen.", "français": "Vingt francs l'aune."}
{"breton": "N'en d'eo quet mezer a ugueut liour ar voalen.", "français": "Ce n'est pas du drap de 20 francs l'aune."}
{"breton": "Quementse a dal.", "français": "Il vaut ce prix."}
{"breton": "Hag euz an hini caer eo?", "français": "Est-ce du beau?"}
{"breton": "Ia, autrou.", "français": "Oui, monsieur."}
{"breton": "N'am euz quet affer oc'h ar priz-ze, re guer eo.", "français": "Je n'en veux pas à ce prix-là, c'est trop cher."}
{"breton": "Ne gaffoc'h quet a velloc'h marc'had en holl staliou.", "français": "Vous n'en trouverez pas à meilleur marché dans toutes les boutiques."}
{"breton": "Ha c'houi a fell d'eoc'h he rei evit pemzec liour?", "français": "Voulez-vous le donner pour quinze francs?"}
{"breton": "E guirionez, coll em be, coust a ra din ouspen triuec'h.", "français": "En vérité, j'y perdrais, il me coûte plus de dix-huit."}
{"breton": "Impossubl eo.", "français": "Ce n'est pas possible."}
{"breton": "Quer guir eo evel m'az hoc'h aze.", "français": "C'est aussi vrai que vous voilà."}
{"breton": "N'hoc'h euz-hu nemet eur guer?", "français": "N'avez-vous qu'une parole?"}
{"breton": "Ho guer diveza eo?", "français": "Est-ce votre dernier mot?"}
{"breton": "Ia, me hoc'h assur.", "français": "Oui, je vous assure."}
{"breton": "Ha c'houi a fell d'eoc'h triuec'h liour?", "français": "En voulez-vous dix-huit francs."}
{"breton": "Ret eo din gounit eun dra bennâc.", "français": "Il faut que je gagne quelque chose."}
{"breton": "Naoniec a fell d'eoc'h?", "français": "En voulez-vous dix-neuf?"}
{"breton": "Deoc'h eo.", "français": "Il est à vous."}
{"breton": "Dialog.", "français": "Dialogue."}
{"breton": "Ha beza hoc'h euz-hu tocou mad?", "français": "Avez-vous de bons chapeaux?"}
{"breton": "Ha c'houi a fell deoc'h caout eur c'hastor?", "français": "Voulez-vous un castor?"}
{"breton": "Discuezit din unan.", "français": "Montrez-m'en un."}
{"breton": "Chetu aze unan mad.", "français": "En voilà un bon."}
{"breton": "Peguement a dal-hen?", "français": "Combien vaut-il?"}
{"breton": "Dec liour a dal.", "français": "Il vaut dix francs."}
{"breton": "Ne roin quet quementse anezàn.", "français": "Je n'en donnerai pas tant."}
{"breton": "Peguement a rofoc'h-hu anezàn?", "français": "Combien en voulez-vous donner?"}
{"breton": "Ne ouzoun petra quiniga deoc'h, re a c'houlennit.", "français": "Je ne sais que vous offrir, vous demandez trop."}
