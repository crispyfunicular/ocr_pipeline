{"breton": "Ne d'eo quet sonnet eun heur c'hoaz.", "français": "Une heure n'est pas encore sonnée."}
{"breton": "Ne d'eo quet sonnet div heur c'hoaz.", "français": "Deux heures ne sont pas encore sonnées."}
{"breton": "N'am euz quet clevet an horolach.", "français": "Je n'ai pas entendu l'horloge."}
{"breton": "Div heur eo hervez an heol.", "français": "Il est deux heures au soleil."}
{"breton": "Etre teir ha pedeir heur eo.", "français": "Il est entre trois et quatre heures."}
{"breton": "Emâ pedeir heur o paouez sonn.", "français": "Quatre heures viennent de sonner."}
{"breton": "Sonnet eo pemp heur.", "français": "Cinq heures sont sonnées."}
{"breton": "Vardro c'huec'h heur.", "français": "Environ les six heures."}
{"breton": "An horolach-mâ zo araog.", "français": "Cette horloge avance."}
{"breton": "An horolach-mâ zo varlerc'h.", "français": "Cette horloge retarde."}
{"breton": "Ne d'eo nemet eun heur d'am montr.", "français": "Il n'est qu'une heure à ma montre."}
{"breton": "An horolachou n'en em accordont quet.", "français": "Les horloges ne s'accordent pas."}
{"breton": "Guelit diouc'h an heol.", "français": "Voyez au soleil."}
{"breton": "Tremenet eo an heur.", "français": "L'heure est passée."}
{"breton": "Deuet oe he heur.", "français": "Son heure était venue."}
{"breton": "Ac'han da eiz deiz.", "français": "D'ici à huit jours."}
{"breton": "Ac'han da bemzec deiz.", "français": "D'ici à quinze jours."}
{"breton": "Parlantit.", "français": "Parlez."}
{"breton": "Ne barlantit quer cre aoualc'h.", "français": "Vous parlez trop bas."}
{"breton": "Vardro an noz.", "français": "Vers le soir."}
{"breton": "Deuit dre amâ.", "français": "Venez par ici."}
{"breton": "It dre aze.", "français": "Allez par là."}
{"breton": "Tremenit dre amâ.", "français": "Passez par ici."}
{"breton": "Tremenit dre aze.", "français": "Passez par là."}
{"breton": "En dourn deou.", "français": "A main droite."}
{"breton": "En dourn cleiz.", "français": "A main gauche."}
{"breton": "Oc'h an heol.", "français": "Au soleil."}
{"breton": "Oc'h al loar.", "français": "A la lune."}
{"breton": "Distroit en dourn deou.", "français": "Détournez à main droite."}
{"breton": "Er c'huec'hvet ti en dourn cleiz.", "français": "A la sixième maison à main gauche."}
{"breton": "Demezet ez hoc'h-hu ?", "français": "Etes-vous marié ?"}
{"breton": "Pet gueach ez hoc'h-hu bet demezet ?", "français": "Combien de fois avez-vous été marié ?"}
{"breton": "Ped greg hoc'h ez euz-hu bet ?", "français": "Combien de femmes avez-vous eues ?"}
{"breton": "Ho tad hag ho mam hoc'h euz-hu c'hoaz ?", "français": "Avez-vous encore vos père et mère."}
{"breton": "Autrou, ha beo eo ho tad ?", "français": "Monsieur, votre père est-il vivant ?"}
{"breton": "Maro eo he dad hag he vam.", "français": "Son père et sa mère sont morts."}
{"breton": "Itroun, ha beo eo ho mam ?", "français": "Madame votre mère est-elle vivante ?"}
{"breton": "Maro eo va mam.", "français": "Ma mère est morte."}
{"breton": "Maro eo va zad.", "français": "Mon père est mort."}
{"breton": "Pevar bloaz a zo abaoue ma eo maro va zad.", "français": "Il y a quatre ans que mon père est mort."}
{"breton": "Va mam a zo azdemezet.", "français": "Ma mère est remariée."}
{"breton": "Va zad a zo azdemezet.", "français": "Mon père est remarié."}
{"breton": "Ha demezet eo an autrou ?", "français": "Monsieur est-il marié ?"}
{"breton": "Ha demezet eo an itroun ?", "français": "Madame est-elle mariée ?"}
{"breton": "Pet buguel hoc'h euz-hu ?", "français": "Combien d'enfants avez-vous ?"}
{"breton": "Pevar am euz.", "français": "J'en ai quatre."}
{"breton": "Mibien pe merc'hed.", "français": "Fils ou filles."}
{"breton": "Eur mab am euz ha teir verc'h.", "français": "J'ai un fils et trois filles."}
{"breton": "Ped breur hoc'h euz hu ?", "français": "Combien de frères avez-vous ?"}
{"breton": "N'am euz nicun.", "français": "J'en ai aucun."}
{"breton": "Ped c'hoar hoc'h euz-hu ?", "français": "Combien de sœurs avez-vous ?"}
{"breton": "Pe oad en deuz an autrou ?", "français": "Quel âge a Monsieur ?"}
{"breton": "Pe oad e deuz an itroun ?", "français": "Quel âge a Madame ?"}
{"breton": "Ped buguel en deuz-hen ?", "français": "Combien d'enfants a-t-il ?"}
{"breton": "Ped e deuz-hi ?", "français": "Combien en a-t-elle ?"}
{"breton": "P'eur e ielot-hu var ar meaz ?", "français": "Quand irez-vous à la campagne ?"}
{"breton": "Hag eat eo autrou var ar meaz ?", "français": "Monsieur est allé à la campagne ?"}
{"breton": "Eat eo an itroun da Bariz.", "français": "Madame est allée à Paris."}
{"breton": "Vademezel ho c'hoar hag hi a zo demezet ?", "français": "Mademoiselle votre sœur est-elle mariée ?"}
{"breton": "P'eur e oe-hi demezet ?", "français": "Quand fut-elle mariée ?"}
{"breton": "Hi ne d'eo quet demezet.", "français": "Elle n'est pas mariée."}
{"breton": "Hi a ia da zemezi.", "français": "Elle va se marier."}
{"breton": "Ne fell quet dezi demezi.", "français": "Elle ne veut pas se marier."}
