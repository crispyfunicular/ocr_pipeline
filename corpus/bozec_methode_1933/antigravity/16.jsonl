{"breton": "Ar vran a zo du", "français": "Le corbeau est noir"}
{"breton": "An hent a zo hir", "français": "Le chemin est long"}
{"breton": "An iliz a zo uhel", "français": "L'église est haute"}
{"breton": "An ejen a zo teo", "français": "Le bœuf est gros"}
{"breton": "Anoiou-gwan", "français": "Adjectifs"}
{"breton": "Penaos eman ar vran ?", "français": "Comment est le corbeau ?"}
{"breton": "N'eo ket gwenn ?", "français": "Il n'est pas blanc ?"}
{"breton": "Nann ; du eo.", "français": "Non ; il est noir."}
{"breton": "Penaos ez oc'h, c'houi ?", "français": "Comment êtes-vous, vous ?"}
{"breton": "Azezet pe en ho sav ?", "français": "Assis ou debout ?"}
{"breton": "Petra eo an dra-man ?", "français": "Qu'est-ce que ceci ?"}
{"breton": "Eur bluenn-bloum", "français": "Un crayon ?"}
{"breton": "Penaos eman ?", "français": "Comment est-il ?"}
{"breton": "Du, ruz pe c'hlas ?", "français": "Noir, rouge ou bleu ?"}
{"breton": "Setu aman eur reolenn hag eur wialenn : pehini anezo eo an hiran ?", "français": "Voici une règle et une baguette : laquelle d'entre elles est la plus longue ?"}
{"breton": "Ar wialenn.", "français": "La baguette."}
{"breton": "Ar reolenn a zo eta berroc'h evit ar wialenn.", "français": "La règle est donc plus courte que la baguette."}
{"breton": "Eur vlevenn a zo moanoc'h evit eun neudenn.", "français": "Un cheveu est plus mince qu'un fil."}
