{"breton": "Me ho ped d'am iscuzit", "français": "Je vous prie de m'excuser"}
{"breton": "Mont a rit-hu quit?", "français": "Vous en allez-vous?"}
{"breton": "N'ez it quet quit c'hoaz", "français": "Ne vous en allez pas encore"}
{"breton": "Choumit c'hoaz eun nebeut", "français": "Demeurez encore un peu"}
{"breton": "Ne hellàn quet", "français": "Je ne saurais"}
{"breton": "Quenavezo 'ta", "français": "Adieu donc"}
{"breton": "Dont a rin d'ho quelet varc'hoaz", "français": "Je reviendrai vous voir demain"}
{"breton": "Va oblija a reoc'h", "français": "Vous m'obligerez"}
{"breton": "E peleac'h eoc'h-hu deac'h", "français": "Où fûtes-vous hier?"}
{"breton": "En opera e oen", "français": "Je fus à l'opéra"}
{"breton": "Hag hen a oa caer?", "français": "Etait-il beau?"}
{"breton": "Caer braz", "français": "Fort beau"}
{"breton": "An Impalaer a oa eno?", "français": "L'empereur y était-il?"}
{"breton": "Ia, hag an duq hag an duquez", "français": "Oui, et le duc et la duchesse"}
{"breton": "P'eur e tistrooc'h-hu?", "français": "Quand y retournerez-vous?"}
{"breton": "Goude varc'hoaz", "français": "Après demain"}
{"breton": "C'hoant am euz da vont ganeoc'h", "français": "J'ai envie d'aller avec vous"}
{"breton": "Joa vezo din caout ho compagnunez", "français": "Je serai bien aise de votre compagnie"}
{"breton": "Derc'hel a reoc'h-hu mad d'ho quer?", "français": "Tiendrez-vous votre parole?"}
{"breton": "M'her promet d'eoc'h", "français": "Je le promets"}
{"breton": "E peleac'h ez hoc'h hu bet er mintin-mâ?", "français": "Où avez vous été ce matin?"}
{"breton": "E ti commun", "français": "A l'hôtel-de-ville"}
{"breton": "Eun ti caer eo?", "français": "C'est un bel édifice"}
{"breton": "E peleac'h ez eot-hu varc'hoaz?", "français": "Où irez-vous demain?"}
{"breton": "Er meaz a guear", "français": "Hors de la ville"}
{"breton": "P'eur e viot-hu distro?", "français": "Quand reviendrez-vous?"}
{"breton": "Varc'hoaz da noz", "français": "Demain au soir"}
{"breton": "Bet ez hoc'h-hu e Bro-Zaoz?", "français": "Avez-vous été en Angleterre?"}
{"breton": "Nan, biscoaz enni ne oun bet", "français": "Non, je n'y ai jamais été"}
{"breton": "E peleac'h ez it-hu bremâ?", "français": "Où allez-vous à cette heure?"}
{"breton": "Me a ia d'am zi", "français": "Je vais chez moi"}
{"breton": "Da bet heur ec'h heller ho caout er guear?", "français": "A quelle heure vous peut-on trouver au logis?"}
{"breton": "Adalec seiz heur euz ar mintin betec dec", "français": "Depuis sept heures du matin jusqu'à dix"}
{"breton": "D'an enor d'ho quelet", "français": "A l'honneur de vous revoir"}
{"breton": "Ha c'houi a zo Gall?", "français": "Etes-vous Français?"}
{"breton": "En ho servich", "français": "A votre service"}
{"breton": "Ha pell amzer zo ez hoc'h-hu e Guemper?", "français": "Y a-t-il longtemps que vous êtes à Quimper?"}
{"breton": "Er zizun dremenet ec'h arruiz", "français": "J'y suis arrivé la semaine passée"}
{"breton": "E peleac'h e lojit-hu?", "français": "Où logez-vous?"}
{"breton": "E parc ar C'hosti", "français": "Sur le Parc"}
{"breton": "E ti piou?", "français": "Chez qui?"}
{"breton": "En hostaleri ar C'hleze", "français": "A l'hôtel de l'Épée"}
{"breton": "Erfat en em gavit-hu?", "français": "Y êtes-vous bien?"}
{"breton": "Erfat en em gavàn", "français": "Je m'y trouve bien"}
{"breton": "Tremenet ez hoc'h-u dre Naonet?", "français": "Avez-vous passé par Nantes?"}
{"breton": "Nan, autrou, dre Roazon oun tremenet", "français": "Non, monsieur, j'ai passé par Rennes"}
{"breton": "Petra a lavarit-hu euz a Vreiz?", "français": "Que dites-vous de la Bretagne?"}
{"breton": "Ar c'haera bro eo euz ar bed", "français": "C'est le plus beau pays du monde"}
{"breton": "N'hon euz-ni quet amàn itrounezet caër?", "français": "N'avons-nous pas ici de belles dames?"}
{"breton": "Caer int evel elez", "français": "Elles sont belles comme des anges"}
{"breton": "Diouallit deoc'h, autrou", "français": "Prenez garde à vous, monsieur"}
{"breton": "Euz a betra, autrou?", "français": "De quoi, monsieur?"}
{"breton": "Da goueza en ho chadennou", "français": "De tomber dans leurs chaines"}
